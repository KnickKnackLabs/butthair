# Hammerspoon CLI helper — source this from tasks
# Not executable: won't appear in mise task list

HS_CLI="/Applications/Hammerspoon.app/Contents/Frameworks/hs/hs"

hs_check() {
    if [ ! -x "$HS_CLI" ]; then
        echo "error: Hammerspoon not found" >&2
        echo "Install from https://www.hammerspoon.org/" >&2
        exit 1
    fi
    if ! pgrep -x "Hammerspoon" > /dev/null; then
        echo "error: Hammerspoon is not running" >&2
        exit 1
    fi
}

# Validate an app name is safe to interpolate into Lua
hs_validate_app() {
    if ! echo "$1" | grep -qE '^[a-zA-Z0-9 ._-]+$'; then
        echo "error: invalid app name: $1" >&2
        exit 1
    fi
}

# Validate a string is safe for Lua long bracket interpolation ([[...]])
hs_validate_lua_str() {
    if echo "$1" | grep -qF ']]'; then
        echo "error: value must not contain ']]'" >&2
        exit 1
    fi
}

# Validate a value is a number (integer)
hs_validate_num() {
    if ! echo "$1" | grep -qE '^-?[0-9]+$'; then
        echo "error: expected number, got: $1" >&2
        exit 1
    fi
}

# Check if Hammerspoon has notification permission.
# Sends a hidden test notification, checks delivery, withdraws it.
hs_check_notify() {
    local result
    result=$(hs_run '
local n = hs.notify.new({title="__butthair_test__", informativeText="permission check"}):send()
hs.timer.usleep(500000)
local delivered = hs.notify.deliveredNotifications()
for _, d in ipairs(delivered) do
    if d:title() == "__butthair_test__" then
        d:withdraw()
        return "ok"
    end
end
return "blocked"
')
    if [ "$result" = "blocked" ]; then
        echo "error: Hammerspoon notifications are not allowed" >&2
        echo "Enable in: System Settings → Notifications → Hammerspoon → Allow Notifications" >&2
        exit 1
    fi
}

# Check if Hammerspoon has screen recording permission.
hs_check_screen_recording() {
    local result
    result=$(hs_run '
local img = hs.screen.mainScreen():snapshot()
if img then return "ok" else return "blocked" end
')
    if [ "$result" = "blocked" ]; then
        echo "error: Hammerspoon does not have screen recording permission" >&2
        echo "Enable in: System Settings → Privacy & Security → Screen Recording → Hammerspoon" >&2
        exit 1
    fi
}

hs_run() {
    local _hs_out _hs_err
    _hs_out=$(mktemp)
    _hs_err=$(mktemp)
    "$HS_CLI" -c "$1" >"$_hs_out" 2>"$_hs_err"
    local _hs_rc=$?
    # Filter out noisy extension loading lines from both streams
    sed '/^-- Loading extension: /d; /^-- Loading ~/d' "$_hs_out"
    sed '/^-- Loading extension: /d; /^-- Loading ~/d' "$_hs_err" >&2
    rm -f "$_hs_out" "$_hs_err"
    return $_hs_rc
}
